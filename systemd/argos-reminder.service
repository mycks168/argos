[Unit]
Description=ARGOS Reminder daemon
After=network-online.target argos.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@/services/argos-reminder
EnvironmentFile=-@PROJECT_DIR@/services/argos-reminder/.env
ExecStart=@PROJECT_DIR@/services/argos-reminder/.venv/bin/argos-reminder-daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
