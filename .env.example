# ARGOS: Autonomous Road Guardian & Observation System

# stt-gateway
# 空にするとfaster-whisperだけを使う。設定済みの場合も、stt-gateway障害時はfaster-whisperへフォールバックする。
STT_GATEWAY_URL=
STT_GATEWAY_LANGUAGE=ja
STT_GATEWAY_BEARER_TOKEN=
# trueにすると録音WAVをffmpegでOpus(.opus)に圧縮してから送信し、アップロードサイズを削減する。
# stt-gateway側がOpus受信に対応している必要がある。
STT_GATEWAY_USE_OPUS=false
STT_GATEWAY_OPUS_BITRATE=24k

# faster-whisper STT fallback
ARGOS_WHISPER_MODEL_SIZE=small
ARGOS_WHISPER_DEVICE=auto
ARGOS_WHISPER_COMPUTE_TYPE=int8

# tts-filter
TTS_FILTER_URL=http://127.0.0.1:9191
TTS_FILTER_BEARER_TOKEN=
# VOICEVOX へ送る前の読み上げ区切り文字。改行は常に区切りとして扱う。
ARGOS_TTS_DELIMITERS=。！？!?

# VOICEVOX
# 空にするとKokoroだけを使う。設定済みの場合も、VOICEVOX障害時はKokoroへフォールバックする。
VOICEVOX_URL=http://localhost:50021
# VOICEVOX側でBearer認証を使う場合だけ指定する。
VOICEVOX_BEARER_TOKEN=
VOICEVOX_SPEAKER=2
VOICEVOX_SAMPLE_RATE=48000
# 1.0が標準。少し早めにする場合は1.1を指定する。
VOICEVOX_SPEED_SCALE=1.1
# 1.0が標準。音量をブーストする場合は1.5などを指定する。
VOICEVOX_VOLUME_SCALE=2.0
# trueにするとsynthesisへ Accept: audio/opus を付け、Opus対応ラッパーが返した
# Ogg OpusをffmpegでWAVへデコードして再生する。素のVOICEVOX Engineでは無効のままにする。
VOICEVOX_ACCEPT_OPUS=false

# TTSキャッシュ
ARGOS_TTS_CACHE_ENABLED=true
ARGOS_TTS_CACHE_MAX_CHARS=30
ARGOS_TTS_CACHE_MAX_SIZE_MB=200
ARGOS_TTS_CACHE_DIR=cache/tts

# Kokoro TTS fallback
ARGOS_KOKORO_VOICE=jf_alpha
ARGOS_KOKORO_SPEED=1.0
ARGOS_KOKORO_REPO_ID=hexgrad/Kokoro-82M
ARGOS_KOKORO_SAMPLE_RATE=24000

# Raspberry Pi GPIO / ALSA
# GPIOなし環境では空欄にする。Raspberry PiでPTTを使う場合はBCM番号を指定する。
ARGOS_PTT_GPIO=
# `cat /proc/asound/cards` のカード名に合わせる。
# 例: `2 [USBMic]: USB-Audio - USB Microphone` の場合は `plughw:CARD=USBMic,DEV=0`
AUDIO_DEVICE=default
# 複数候補を登録する場合はセミコロン区切りで指定する。接続済みカードを録音開始時に選ぶ。
# ARGOS_INPUT_DEVICES / ARGOS_AUDIO_INPUT_DEVICES でも指定できる。
AUDIO_INPUT_DEVICES=default
AUDIO_OUTPUT_DEVICE=default
# HWミキサー(amixer)で音量を制御する出力カード名。未設定なら amixer は使わず、
# 音量はWAVスケール(ソフトウェア音量)のみで調整する。PipeWire仮想シンク(ec_sink)経由の
# 場合は amixer がシンク音量を触ると二重に効くため、未設定のままにすること。
AUDIO_OUTPUT_CARD=
AUDIO_OUTPUT_VOLUME=70
ARGOS_AUDIO_STATE_PATH=~/.local/state/argos/audio-state.json
AUDIO_SAMPLE_RATE=16000
SILENCE_RMS_THRESHOLD=200

# ウェイクワード。ARGOS専用機向けの既定では有効。
# LiveKit形式ONNXモデルで「アルゴス」を検知し、検知後の発話を既存処理へ渡す。
ARGOS_WAKEWORD_ENABLED=true
ARGOS_WAKEWORD_MODEL_DIR=models/wakeword
ARGOS_WAKEWORD_THRESHOLD=0.5
ARGOS_WAKEWORD_CAPTURE_SAMPLE_RATE=48000
ARGOS_WAKEWORD_WINDOW_SECONDS=2.0
ARGOS_WAKEWORD_INTERVAL_SECONDS=0.25
ARGOS_WAKEWORD_CHUNK_MS=80
ARGOS_WAKEWORD_RECORD_MIN_SECONDS=1.0
ARGOS_WAKEWORD_RECORD_MAX_SECONDS=12.0
ARGOS_WAKEWORD_RECORD_SILENCE_SECONDS=1.0
ARGOS_WAKEWORD_PRE_ROLL_SECONDS=3.0
ARGOS_WAKEWORD_MIN_ACTUAL_SECONDS=0.2
ARGOS_WAKEWORD_ENDPOINT_MODE=vad
ARGOS_WAKEWORD_VAD_MODEL=models/wakeword/silero_vad_v6.onnx
ARGOS_WAKEWORD_VAD_THRESHOLD=0.35
ARGOS_WAKEWORD_VAD_MIN_SILENCE_SECONDS=1.5
ARGOS_WAKEWORD_VAD_CHECK_SECONDS=0.32
ARGOS_WAKEWORD_TTS_COOLDOWN_SECONDS=2.0
# バージイン: 読み上げ中でもウェイクワードで割り込めるようにする。要AEC(音響エコーキャンセル)。
# 有効化するには scripts/setup-echo-cancel.sh を実行し、AUDIO_OUTPUT_DEVICE=ec_sink /
# AUDIO_INPUT_DEVICES=ec_source（ALSAブリッジ名）へ差し替える（docs/basic_design.md参照）。
ARGOS_WAKEWORD_BARGEIN_ENABLED=false
ARGOS_WAKEWORD_SCORE_LOG_PATH=/tmp/argos/wakeword-score.log
# STT結果が「アルゴス」などの呼びかけから始まる場合だけウェイクワード発話として処理する。
ARGOS_WAKEWORD_REQUIRE_STT_WAKEWORD=false
# 破棄したウェイクワード録音を再学習候補としてtmpfsへ保存する。
ARGOS_WAKEWORD_FALSE_POSITIVE_CAPTURE=true
ARGOS_WAKEWORD_FALSE_POSITIVE_DIR=/tmp/argos/wakeword-candidates
# STT先頭の呼びかけ表記ゆれ（カンマ/全角読点/改行区切り）。空なら組み込みの既定（アルゴス等）を使う。
ARGOS_WAKEWORD_ALIASES=

# ST7789 LCD
ARGOS_LCD_ENABLED=false
ARGOS_LCD_WIDTH=76
ARGOS_LCD_HEIGHT=284
ARGOS_LCD_X_OFFSET=82
ARGOS_LCD_Y_OFFSET=18
ARGOS_LCD_DC_PIN=D25
ARGOS_LCD_CS_PIN=D5
ARGOS_LCD_RESET_PIN=D24
ARGOS_LCD_BAUDRATE=4000000
ARGOS_LCD_FONT_PATH=
ARGOS_LCD_FONT_SIZE=16

# HDMI dashboard
ARGOS_DASHBOARD_ENABLED=true
# kioskブラウザはローカルからアクセスするため既定はlocalhostのみ。
# LAN内の別端末から見せる場合や、PiZeroモバイル端末(argos-terminal)を
# Tailscale越しに繋ぐ場合だけ、Tailscaleアドレスや 0.0.0.0 などへ広げる。
ARGOS_DASHBOARD_HOST=127.0.0.1
ARGOS_DASHBOARD_PORT=8765
# ダッシュボードとPiZero端末API(/api/terminal/*)で共用するBearerトークン。
ARGOS_DASHBOARD_TOKEN=
# ダッシュボード閲覧用アクセスキー。設定すると画面・状態API・SSE・画像の閲覧に
# ?key=<値> か発行済みCookie、またはBearerトークンが必要になる。空なら従来通り制限なし。
ARGOS_DASHBOARD_VIEW_KEY=
ARGOS_DASHBOARD_SCREENSAVER_SECONDS=1800
# 初回表示時のフォントサイズ。small / medium / large。
ARGOS_DASHBOARD_DEFAULT_FONT_SIZE=medium
ARGOS_LOCATION_PROVIDER=remote
ARGOS_REMOTE_LOCATION_URL=http://localhost:8080/gps
ARGOS_REMOTE_LOCATION_TIMEOUT_SECONDS=2

# LLM agent
# codex、antigravity、hermes、claude を指定できる。
ARGOS_AGENT_PROVIDER=codex
# Argos自身が管理するエージェント状態ファイル。
ARGOS_AGENT_STATE_PATH=~/.argos/agent-sessions.json
# エージェントへ会話開始時だけ渡すARGOS共通指示。
ARGOS_AGENT_SYSTEM_PROMPT=
ARGOS_AGENT_SYSTEM_PROMPT_FILE=
ARGOS_AGENT_SYSTEM_PROMPT_STATE_PATH=~/.argos/agent-system-prompts.json
# 既定システム指示（車載アシスタント想定）の全文差し替え。空なら組み込みの既定文面を使う。
ARGOS_AGENT_DEFAULT_SYSTEM_PROMPT=
ARGOS_AGENT_SKILLS_DIR=/opt/argos/skills
# 既定の作業ディレクトリ。
ARGOS_AGENT_CWD=/opt/argos
# Agent Runnerを使う場合、ARGOS本体はこのURLへジョブを依頼する。
# 空の場合は従来どおりARGOS本体が直接CLIを起動する。
ARGOS_AGENT_RUNNER_URL=http://127.0.0.1:28765
ARGOS_AGENT_RUNNER_TOKEN=
# argos-agent-runner 側の待受とジョブ保存先。
ARGOS_AGENT_RUNNER_HOST=127.0.0.1
ARGOS_AGENT_RUNNER_PORT=28765
ARGOS_AGENT_RUNNER_STATE_DIR=~/.local/state/argos/agent-runner
# エージェント別の利用枠取得コマンド。JSONを標準出力へ返すコマンドを指定する。
# 例: {"weekly_remaining": 10, "weekly_limit": 100, "monthly_remaining": 120, "monthly_limit": 1000}
ARGOS_AGENT_USAGE_REFRESH_SECONDS=60
ARGOS_AGENT_USAGE_TIMEOUT_SECONDS=5
ARGOS_AGENT_USAGE_COMMAND_CODEX=cat /opt/argos/services/agent-limit/codex.json
ARGOS_AGENT_USAGE_COMMAND_ANTIGRAVITY=cat /opt/argos/services/agent-limit/antigravity.json
ARGOS_AGENT_USAGE_COMMAND_CLAUDE=cat /opt/argos/services/agent-limit/claude.json
ARGOS_AGENT_USAGE_COMMAND_HERMES=cat /opt/argos/services/agent-limit/hermes.json
# ダッシュボード左ペインのWi-Fi状態更新間隔。
ARGOS_WIFI_STATUS_REFRESH_SECONDS=10
# インストーラーは `update_limits.py` を5分おきに実行するcronをARGOS実行ユーザーへ登録する。
# 手動更新する場合は `uv --directory /opt/argos/services/agent-limit run python update_limits.py` を実行する。

# 進捗フレーズ決定API
ARGOS_ACKNOWLEDGEMENT_URL=http://127.0.0.1:23032
ARGOS_ACKNOWLEDGEMENT_TOKEN=

# エージェント待機中の進捗音声（provider共通）。起動直後に短く通知し、応答が遅い場合は一定間隔で追加通知する。
# 旧 ARGOS_CODEX_PROGRESS_* も後方互換で読み込む（新名が優先）。
ARGOS_AGENT_PROGRESS_VOICE=true
ARGOS_AGENT_PROGRESS_FIRST_DELAY_SECONDS=15
ARGOS_AGENT_PROGRESS_INTERVAL_SECONDS=30
# 進捗フレーズの上書き。セミコロン（半角/全角）または改行区切り。空なら組み込みの既定フレーズを使う。
ARGOS_AGENT_PROGRESS_START_PHRASES=
ARGOS_AGENT_PROGRESS_WAIT_PHRASES=

# Codex CLI
ARGOS_CODEX_HOME=
ARGOS_CODEX_MODEL=
ARGOS_CODEX_SANDBOX=workspace-write
ARGOS_CODEX_BYPASS_SANDBOX=true
ARGOS_CODEX_APPROVAL=on-request
ARGOS_CODEX_EXTRA_ARGS=
# Codexの応答読み上げ方式。stream=途中経過を逐次読み上げる(既定) / final=完了後のまとめだけ読み上げる
# (Codexの完了後の出力は途中経過の続きではなくまとめ直しのことがあり、両方読むと二重に話すため切替可能にしている)
ARGOS_CODEX_STREAM_MODE=stream

# Antigravity CLI
ARGOS_ANTIGRAVITY_COMMAND=agy
ARGOS_ANTIGRAVITY_HOME=~/.gemini/antigravity-cli
ARGOS_ANTIGRAVITY_MODEL=
ARGOS_ANTIGRAVITY_EXTRA_ARGS=
ARGOS_ANTIGRAVITY_SKIP_PERMISSIONS=false
ARGOS_ANTIGRAVITY_SANDBOX=false
ARGOS_ANTIGRAVITY_PRINT_TIMEOUT=10m0s
ARGOS_ANTIGRAVITY_CONTINUE_SESSION=true
ARGOS_ANTIGRAVITY_RESUME_SAVED=true
ARGOS_ANTIGRAVITY_PROMPT_PREFIX=

# Claude Code。スロット側でモデルを省略した場合の全体既定値。
ARGOS_CLAUDE_MODEL=

# Hermes Agent CLI
ARGOS_HERMES_COMMAND=hermes
ARGOS_HERMES_MODEL=
ARGOS_HERMES_PROVIDER=
ARGOS_HERMES_TOOLSETS=
ARGOS_HERMES_SKILLS=
ARGOS_HERMES_SOURCE=argos
ARGOS_HERMES_PASS_SESSION_ID=true
ARGOS_HERMES_RESUME_SAVED=true
ARGOS_HERMES_EXTRA_ARGS=

# 最初の発話処理時の挨拶。前回利用時刻はローカルのJSONへ保存する。
ARGOS_GREETING_ENABLED=true
ARGOS_GREETING_STATE_PATH=~/.local/state/argos/greeting-state.json

# 起動演出
ARGOS_STARTUP_SPLASH_ENABLED=true
ARGOS_STARTUP_SPLASH_SECONDS=3
ARGOS_STARTUP_SOUND_ENABLED=true

# 本人確認。ハッシュは `uv run scripts/hash-auth-keyword.py` で作成する。
# STTの表記ゆれを許可する場合は、複数ハッシュをセミコロン区切りで指定する。
ARGOS_AUTH_ENABLED=false
ARGOS_AUTH_KEYWORD_HASH=
ARGOS_AUTH_TRUST_SECONDS=1800
ARGOS_AUTH_FAILURE_THRESHOLD=3
ARGOS_AUTH_FACE_ENABLED=false
ARGOS_AUTH_FACE_SAMPLES_DIR=~/.local/share/argos/face-auth
ARGOS_AUTH_FACE_CAPTURE_COMMAND=rpicam-still --nopreview --timeout 700 --width 640 --height 480 -o {path}
ARGOS_AUTH_FACE_CAPTURE_PATH=/tmp/argos/auth-face.jpg
# 顔認証失敗時などにダッシュボードへ見せる撮影画像のコピー先。
ARGOS_CAMERA_SNAPSHOT_PATH=/tmp/argos/camera-latest.jpg
ARGOS_AUTH_FACE_IMAGE_ROTATION=0
ARGOS_AUTH_FACE_THRESHOLD=68
ARGOS_AUTH_FACE_MIN_MATCHES=1
ARGOS_AUTH_FACE_DETECTION_ENABLED=true
ARGOS_AUTH_FACE_MIN_DETECTED_FACES=1
ARGOS_AUTH_FACE_MAX_DETECTED_FACES=1
ARGOS_AUTH_FACE_DETECTOR_MODEL_PATH=~/.local/share/argos/face-models/face_detection_yunet_2023mar.onnx
ARGOS_AUTH_FACE_RECOGNIZER_MODEL_PATH=~/.local/share/argos/face-models/face_recognition_sface_2021dec.onnx
ARGOS_AUTH_FACE_SFACE_THRESHOLD=0.363
ARGOS_AUTH_ALERT_COMMAND=
ARGOS_AUTH_WARNING_SOUND_ENABLED=true
ARGOS_AUTH_WARNING_DELAY_SECONDS=10
ARGOS_AUTH_ALERT_DELAY_SECONDS=30
ARGOS_AUTH_WARNING_INTERVAL_SECONDS=10

# 複数スロット。書式: 名前,provider,cwd[,VOICEVOX話者ID[,モデル]]
# PTT ダブルクリックで順番に切り替える。
# 新規セットアップ時は `uv run argos-install --configure` で使うproviderとスロットを選択する。
# ARGOS_AGENT_SLOT_1=Codex,codex,/home/argos,2,gpt-model
# ARGOS_AGENT_SLOT_2=Claude,claude,/home/argos,8,sonnet
# ARGOS_AGENT_SLOT_3=Antigravity,antigravity,/home/argos,51,Gemini Model
# ARGOS_AGENT_SLOT_4=Hermes,hermes,/home/argos,2
# 単一既定スロットだけ話者を変える場合:
# ARGOS_AGENT_SLOT_VOICEVOX_SPEAKER=2

# テキスト入出力で動作確認する場合
DRY_RUN=false

# OSRM Router Server URL
OSRM_URL=
