# ARGOS: Autonomous Road Guardian & Observation System

# stt-gateway
STT_GATEWAY_URL=http://server.local:23000
STT_GATEWAY_LANGUAGE=ja

# tts-filter
TTS_FILTER_URL=http://server.local:9191
TTS_FILTER_BEARER_TOKEN=
# VOICEVOX へ送る前の読み上げ区切り文字。改行は常に区切りとして扱う。
ARGOS_TTS_DELIMITERS=。！？!?

# VOICEVOX
VOICEVOX_URL=http://server.local:50021
VOICEVOX_SPEAKER=2
VOICEVOX_SAMPLE_RATE=48000
# 1.0が標準。少し早めにする場合は1.1を指定する。
VOICEVOX_SPEED_SCALE=1.0

# Raspberry Pi GPIO / ALSA
ARGOS_PTT_GPIO=17
# `cat /proc/asound/cards` のカード名に合わせる。
# 例: `2 [H2]: USB-Audio - HyperX SoloCast 2` の場合は `plughw:CARD=H2,DEV=0`
AUDIO_DEVICE=plughw:CARD=H2,DEV=0
AUDIO_OUTPUT_DEVICE=default
AUDIO_OUTPUT_CARD=
AUDIO_OUTPUT_VOLUME=90
AUDIO_SAMPLE_RATE=16000
SILENCE_RMS_THRESHOLD=200

# ST7789 LCD
ARGOS_LCD_ENABLED=false
ARGOS_LCD_WIDTH=76
ARGOS_LCD_HEIGHT=284
ARGOS_LCD_X_OFFSET=82
ARGOS_LCD_Y_OFFSET=18
ARGOS_LCD_DC_PIN=D25
ARGOS_LCD_CS_PIN=D5
ARGOS_LCD_RESET_PIN=D24
ARGOS_LCD_BAUDRATE=4000000
ARGOS_LCD_FONT_PATH=
ARGOS_LCD_FONT_SIZE=16

# HDMI dashboard
ARGOS_DASHBOARD_ENABLED=false
ARGOS_DASHBOARD_HOST=127.0.0.1
ARGOS_DASHBOARD_PORT=8765
ARGOS_DASHBOARD_TOKEN=

# Codex CLI
ARGOS_CODEX_CWD=/home/pi
ARGOS_CODEX_HOME=
ARGOS_CODEX_MODEL=
ARGOS_CODEX_SANDBOX=workspace-write
ARGOS_CODEX_BYPASS_SANDBOX=false
ARGOS_CODEX_APPROVAL=on-request
ARGOS_CODEX_EXTRA_ARGS=
# Codex待機中の進捗音声。起動直後に短く通知し、応答が遅い場合は一定間隔で追加通知する。
ARGOS_CODEX_PROGRESS_VOICE=true
ARGOS_CODEX_PROGRESS_FIRST_DELAY_SECONDS=8
ARGOS_CODEX_PROGRESS_INTERVAL_SECONDS=20

# 最初の発話処理時の挨拶。前回利用時刻はローカルのJSONへ保存する。
ARGOS_GREETING_ENABLED=true
ARGOS_GREETING_STATE_PATH=~/.local/state/argos/greeting-state.json

# 起動演出
ARGOS_STARTUP_SPLASH_ENABLED=true
ARGOS_STARTUP_SPLASH_SECONDS=3
ARGOS_STARTUP_SOUND_ENABLED=true

# 複数スロット。書式: 名前,cwd,codex_home,model
# PTT ダブルクリックで順番に切り替える。
# ARGOS_CODEX_SLOT_1=作業,/home/pi/project-a,,gpt-5
# ARGOS_CODEX_SLOT_2=調査,/home/pi/project-b,/home/pi/.codex,gpt-5

# テキスト入出力で動作確認する場合
DRY_RUN=false
