[Unit]
Description=ARGOS Reminder daemon
After=network-online.target argos.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yuki/argos-reminder
EnvironmentFile=/home/yuki/argos-reminder/.env
ExecStart=/home/yuki/argos-reminder/.venv/bin/argos-reminder-daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
